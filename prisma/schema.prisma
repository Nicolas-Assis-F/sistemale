generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String      @id @default(cuid())
  sku                String      @unique
  slug               String      @unique
  name               String
  shortDesc          String
  description        String      @db.Text
  specs              Json
  priceCents         Int
  originalPriceCents Int?
  stock              Int         @default(0)
  active             Boolean     @default(true)
  featured           Boolean     @default(false)
  images             String[]
  categoryId         String
  category           Category    @relation(fields: [categoryId], references: [id])
  partItems          PartItem[]
  orderItems         OrderItem[]
  /// Ficha de custo (formação de preço) do produto
  costSheet          CostSheet?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([active, featured])
  @@index([categoryId])
}

model PartItem {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  category       String             @default("Geral")
  quantity       Int                @default(1)
  unitPriceCents Int                @default(0)
  notes          String?
  listItems      PurchaseListItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([productId])
  @@index([category])
}

model PurchaseList {
  id        String             @id @default(cuid())
  name      String
  items     PurchaseListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model PurchaseListItem {
  id             String       @id @default(cuid())
  purchaseListId String
  purchaseList   PurchaseList @relation(fields: [purchaseListId], references: [id], onDelete: Cascade)
  partItemId     String
  partItem       PartItem     @relation(fields: [partItemId], references: [id], onDelete: Cascade)

  @@unique([purchaseListId, partItemId])
  @@index([purchaseListId])
}

// ─── Site institucional (editável pelo admin) ──────────────────────────────────

/// Conteúdo editável das seções institucionais (key: "home" | "sobre" | "servicos" | "contato")
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Itens repetentes exibidos na página de Serviços
model ServiceItem {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/// Fotos de obras / projetos / equipamentos exibidas na Galeria
model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/// Mensagens recebidas pelo formulário de contato
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// ─── Vendas / Produção ─────────────────────────────────────────────────────────

enum OrderStatus {
  ORCAMENTO
  PEDIDO
  EM_FABRICACAO
  CONCLUIDO
  ENTREGUE
  CANCELADO
}

/// Clientes (reutilizáveis entre pedidos)
model Customer {
  id                String            @id @default(cuid())
  code              String            @unique // CU2606-00001
  name              String
  doc               String? // CNPJ/CPF
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zip               String?
  contact           String? // pessoa de contato
  /// Nome fantasia (o `name` é o nome/razão social usado na NF-e)
  tradeName         String?
  /// Enquadramento perante o ICMS (indIEDest da NF-e). Nulo = ainda não informado
  ieIndicator       IeIndicator?
  /// Inscrição estadual como texto (preserva zeros à esquerda)
  stateRegistration String?
  /// Endereços estruturados (PRINCIPAL = fiscal/cobrança). Os campos livres
  /// address/city/state/zip acima são espelho do PRINCIPAL para telas antigas e Asaas
  addresses         CustomerAddress[]
  asaasCustomerId   String?           @unique // cus_... criado sob demanda na 1ª cobrança
  user              User? // conta de acesso do cliente (Better Auth)
  orders            Order[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

/// Funcionários (fabricação e vendas) — sem login; base das comissões
model Employee {
  id             String             @id @default(cuid())
  name           String
  role           String?
  active         Boolean            @default(true)
  phone          String?
  pixKey         String? // para pagar a comissão
  /// Comissão padrão em pontos-base (250 = 2,5%) — sugerida ao vincular a um pedido
  commissionBps  Int                @default(0)
  /// Como é remunerado: nem todo funcionário recebe comissão
  payType        PayType            @default(SALARIO)
  salaryCents    Int                @default(0) // salário mensal bruto
  payDay         Int                @default(5) // dia do pagamento no mês seguinte à competência
  hiredAt        DateTime?
  financeEntries FinanceEntry[]
  orders         Order[]
  commissions    Commission[]
  payouts        CommissionPayout[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([active])
}

/// Pedido / Orçamento (entidade única com fluxo de status)
model Order {
  id             String             @id @default(cuid())
  number         String             @unique // SO2606-0001
  status         OrderStatus        @default(ORCAMENTO)
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  clientRef      String? // Ref. Cliente
  employeeId     String?
  employee       Employee?          @relation(fields: [employeeId], references: [id])
  paymentTerms   String? // Promissoria
  paymentMethod  String? // boleto
  deliveryDate   DateTime?
  notes          String?            @db.Text
  /// Snapshot recalculado a cada alteração (lib/orders/ledger.ts)
  totalCents     Int                @default(0)
  paidCents      Int                @default(0)
  paymentStatus  OrderPaymentStatus @default(NAO_COBRADO)
  source         OrderSource        @default(ADMIN)
  /// Token do link público de acompanhamento (/pedido/[token])
  publicToken    String?            @unique
  items          OrderItem[]
  payments       Payment[]
  events         OrderEvent[]
  commissions    Commission[]
  financeEntries FinanceEntry[]
  paymentPlans   PaymentPlan[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
}

enum OrderSource {
  ADMIN
  SITE
}

enum OrderPaymentStatus {
  NAO_COBRADO
  PENDENTE
  PARCIAL
  PAGO
  ESTORNADO
}

// ─── Financeiro ────────────────────────────────────────────────────────────────

enum PaymentProvider {
  ASAAS
  MANUAL
}

enum PaymentMethod {
  PIX
  BOLETO
  CARTAO
  CLIENTE_ESCOLHE // Asaas UNDEFINED: o cliente escolhe na fatura
  DINHEIRO
  TRANSFERENCIA
  OUTRO
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO // cartão aprovado, saldo ainda não liberado
  RECEBIDO
  VENCIDO
  ESTORNADO
  CANCELADO
}

/// Cobrança/recebimento de um pedido (Asaas ou lançamento manual)
model Payment {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  method           PaymentMethod
  status           PaymentStatus   @default(PENDENTE)
  amountCents      Int
  netCents         Int? // líquido após taxas do Asaas
  dueDate          DateTime?
  paidAt           DateTime?
  description      String?
  externalId       String?         @unique // pay_... no Asaas
  invoiceUrl       String?
  bankSlipUrl      String?
  pixPayload       String?         @db.Text // PIX copia e cola
  pixQrImage       String?         @db.Text // base64 PNG
  installmentCount Int?
  lastSyncedAt     DateTime?
  /// Plano de parcelamento com entrada (lib/billing/plan.ts)
  planId           String?
  plan             PaymentPlan?    @relation(fields: [planId], references: [id])
  planLabel        String? // "Entrada" | "Parcela 2/5"
  finePercent      Float? // multa por atraso (%)
  interestPercent  Float? // juros de mora ao mês (%)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

/// Linha do tempo / auditoria do pedido
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED, UPDATED, STATUS, PAYMENT, COMMISSION, NOTE, LINK
  message   String
  actor     String   @default("admin") // admin | asaas | cliente | sistema
  meta      Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Webhooks recebidos — o id do evento garante idempotência (entrega at-least-once)
model WebhookEvent {
  id          String    @id // evt_... do provedor
  provider    String
  event       String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

// ─── Comissões ─────────────────────────────────────────────────────────────────

enum CommissionRole {
  VENDA
  PRODUCAO
  INDICACAO
  OUTRO
}

enum CommissionStatus {
  PENDENTE // pedido ainda não quitado
  LIBERADA // pedido pago — a pagar ao funcionário
  PAGA
  CANCELADA
}

/// Comissão de um funcionário em um pedido (percentual sobre o total do pedido)
model Commission {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id])
  role        CommissionRole    @default(VENDA)
  bps         Int // pontos-base: 250 = 2,5%
  baseCents   Int // base de cálculo (total do pedido)
  amountCents Int
  status      CommissionStatus  @default(PENDENTE)
  releasedAt  DateTime?
  paidAt      DateTime?
  payoutId    String?
  payout      CommissionPayout? @relation(fields: [payoutId], references: [id])
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([orderId, employeeId, role])
  @@index([employeeId, status])
}

/// Pagamento de comissões a um funcionário (agrupa várias comissões)
model CommissionPayout {
  id           String        @id @default(cuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  amountCents  Int
  paidAt       DateTime      @default(now())
  method       String?
  notes        String?
  commissions  Commission[]
  financeEntry FinanceEntry?
  createdAt    DateTime      @default(now())
}

/// Item de um pedido — do catálogo (productId) ou livre
model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  name           String // designação
  description    String? // 2ª linha
  quantity       Int      @default(1)
  unitPriceCents Int      @default(0)
  icmsPercent    Int      @default(0)
  position       Int      @default(0)

  @@index([orderId])
}

// ─── Conta do cliente (Better Auth) ─────────────────────────────────────────────
// Separado do login do painel (cookie admin_auth). Tabelas no formato do Better Auth 1.7.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Cadastro comercial vinculado (após o e-mail ser verificado)
  customerId    String?   @unique
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Financeiro da empresa ──────────────────────────────────────────────────────

enum PayType {
  SALARIO
  COMISSAO
  SALARIO_COMISSAO
}

enum FinanceType {
  RECEITA
  DESPESA
}

enum FinanceStatus {
  PREVISTO
  PAGO
  CANCELADO
}

/// Lançamento financeiro (contas a pagar/receber). Recebimentos de PEDIDOS vêm
/// da tabela Payment e não são duplicados aqui.
model FinanceEntry {
  id              String            @id @default(cuid())
  type            FinanceType
  category        String // chave de lib/finance-categories.ts
  description     String
  amountCents     Int
  competence      String // AAAA-MM (mês de referência, ex.: folha de setembro)
  dueDate         DateTime
  paidAt          DateTime?
  status          FinanceStatus     @default(PREVISTO)
  method          String? // PIX, boleto, dinheiro…
  account         String? // Caixa, Banco, Asaas…
  supplier        String? // fornecedor / favorecido
  document        String? // nº da nota/boleto
  notes           String?           @db.Text
  employeeId      String?
  employee        Employee?         @relation(fields: [employeeId], references: [id])
  orderId         String?
  order           Order?            @relation(fields: [orderId], references: [id])
  payoutId        String?           @unique
  payout          CommissionPayout? @relation(fields: [payoutId], references: [id])
  recurrenceGroup String? // lançamentos repetidos mensalmente
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type, status, dueDate])
  @@index([competence])
  @@index([employeeId, category, competence])
}

/// Parcelamento negociado: entrada + parcelas em boleto, cada uma é um Payment
model PaymentPlan {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  totalCents       Int
  downPaymentCents Int
  installments     Int // nº de parcelas após a entrada
  finePercent      Float
  interestPercent  Float
  notes            String?
  payments         Payment[]
  createdAt        DateTime  @default(now())

  @@index([orderId])
}

// ─── Infraestrutura: inbox de webhooks e fila de jobs ───────────────────────────
// docs/architecture/admin-santander-nfe.md §2 e §11. A fila é a própria outbox:
// o job é gravado na MESMA transação do fato de negócio e executado depois por
// runJobs() (after() da requisição, cron de recuperação ou worker dedicado).

enum InboxStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Notificação externa persistida antes do 2xx. Dedupe por provedor/conta/chave.
model WebhookInbox {
  id          String      @id @default(cuid())
  provider    String // asaas | santander-billing | santander-pix | focus
  /// Conta/ambiente do provedor (ex.: "sandbox" | "production")
  account     String
  /// Id do evento no provedor (ou hash do payload quando o provedor não tem id)
  dedupeKey   String
  eventType   String
  payload     Json
  status      InboxStatus @default(RECEIVED)
  attempts    Int         @default(0)
  lastError   String?
  receivedAt  DateTime    @default(now())
  processedAt DateTime?

  @@unique([provider, account, dedupeKey])
  @@index([status, receivedAt])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  DEAD // esgotou as tentativas: análise manual
}

model Job {
  id             String    @id @default(cuid())
  type           String
  /// Mesmo fato de negócio nunca gera dois jobs do mesmo tipo
  dedupeKey      String
  payload        Json
  /// Jobs com a mesma chave rodam um de cada vez (ex.: "payment:<id>")
  concurrencyKey String?
  status         JobStatus @default(PENDING)
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  lockedBy       String?
  lockedUntil    DateTime?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([type, dedupeKey])
  @@index([status, runAt])
  @@index([concurrencyKey, status])
}

// ─── Cadastros fiscais ──────────────────────────────────────────────────────────

/// Catálogo oficial de municípios do IBGE (código de 7 dígitos exigido na NF-e).
/// Carga/atualização: npm run db:municipios. Município extinto fica inativo, nunca apagado.
enum IeIndicator {
  CONTRIBUINTE // 1 — contribuinte do ICMS, com IE
  ISENTO // 2 — contribuinte isento de inscrição
  NAO_CONTRIBUINTE // 9 — não contribuinte (pode ou não ter IE)
}

enum AddressKind {
  PRINCIPAL // fiscal e cobrança
  ENTREGA
}

/// Endereço estruturado do cliente. Campos opcionais: o cadastro pode começar
/// incompleto; o que falta vira pendência (lib/domains/customers/fiscal-readiness.ts).
model CustomerAddress {
  id               String        @id @default(cuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind             AddressKind   @default(PRINCIPAL)
  postalCode       String?       @db.Char(8)
  street           String?
  /// Texto: aceita "S/N"
  number           String?
  complement       String?
  district         String?
  municipalityCode String?       @db.Char(7)
  municipality     Municipality? @relation(fields: [municipalityCode], references: [ibgeCode])
  cityName         String?
  state            String?       @db.Char(2)
  countryCode      String        @default("BR") @db.Char(2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([customerId, kind])
  @@index([municipalityCode])
}

model Municipality {
  ibgeCode   String            @id @db.Char(7)
  name       String
  state      String            @db.Char(2)
  /// Nome sem acento e em minúsculas, para busca
  searchName String
  active     Boolean           @default(true)
  updatedAt  DateTime          @updatedAt
  addresses  CustomerAddress[]

  @@index([state, searchName])
}

// ─── Custos e formação de preço ─────────────────────────────────────────────────
// Cálculos em lib/domains/costing (pesos, ficha, Simples, mark-up). Dinheiro em
// centavos (Int); medidas físicas em Float (mm, kg, minutos).

enum MaterialKind {
  BARRA_REDONDA // maciça (ex.: SAE 1045), peso pela geometria
  TUBO // SCH 40/80 etc., peso pela geometria
  COMPONENTE // comprado pronto
  SERVICO // usinagem/tratamento terceirizado
  INSUMO // consumível (eletrodo, tinta, óleo)
}

enum CostUnit {
  KG
  M
  UN
}

model Material {
  id             String                @id @default(cuid())
  name           String
  kind           MaterialKind
  /// Aço/especificação (ex.: "SAE 1045", "ASTM A106 Gr.B")
  grade          String?
  /// Barra: diâmetro. Tubo: diâmetro externo (mm)
  diameterMm     Float?
  /// Tubo: espessura da parede (mm)
  wallMm         Float?
  /// Rótulo da medida (ex.: 2 7/8" SCH 80)
  sizeLabel      String?
  unit           CostUnit              @default(KG)
  /// Custo por unidade (por kg, metro ou peça), com impostos não recuperáveis
  unitCostCents  Int                   @default(0)
  ncm            String?
  supplier       String?
  lastPurchaseAt DateTime?
  notes          String?
  active         Boolean               @default(true)
  lines          CostSheetLine[]
  invoiceItems   PurchaseInvoiceItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([kind, active])
}

/// Processo / centro de trabalho: custo-hora de mão de obra + máquina
model WorkCenter {
  id               String          @id @default(cuid())
  name             String          @unique
  rateCentsPerHour Int             @default(0)
  notes            String?
  active           Boolean         @default(true)
  lines            CostSheetLine[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

/// Parâmetros de formação de preço (percentuais em pontos-base: 100 = 1%)
model PricingProfile {
  id              String      @id @default(cuid())
  name            String
  isDefault       Boolean     @default(false)
  /// Faturamento bruto dos últimos 12 meses (define a faixa do Simples)
  rbt12Cents      Int         @default(0)
  /// Se preenchido, substitui o DAS calculado pelo Anexo II
  dasOverrideBps  Int?
  otherTaxBps     Int         @default(0)
  commissionBps   Int         @default(0)
  paymentFeeBps   Int         @default(0)
  fixedExpenseBps Int         @default(0)
  marginBps       Int         @default(1500)
  sheets          CostSheet[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CostSheet {
  id               String          @id @default(cuid())
  name             String
  /// Produto do catálogo que esta ficha precifica (opcional: subconjuntos não têm)
  productId        String?         @unique
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Quantas unidades a ficha produz (custo unitário = total ÷ lote)
  batchQty         Float           @default(1)
  ncm              String?
  notes            String?
  pricingProfileId String?
  pricingProfile   PricingProfile? @relation(fields: [pricingProfileId], references: [id], onDelete: SetNull)
  lines            CostSheetLine[] @relation("SheetLines")
  usedIn           CostSheetLine[] @relation("SubSheet")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

enum CostLineKind {
  MATERIAL
  COMPONENTE
  PROCESSO
  SERVICO
  SUBFICHA
  OUTRO
}

model CostSheetLine {
  id            String       @id @default(cuid())
  sheetId       String
  sheet         CostSheet    @relation("SheetLines", fields: [sheetId], references: [id], onDelete: Cascade)
  position      Int          @default(0)
  kind          CostLineKind
  description   String?
  materialId    String?
  material      Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  workCenterId  String?
  workCenter    WorkCenter?  @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  subSheetId    String?
  subSheet      CostSheet?   @relation("SubSheet", fields: [subSheetId], references: [id], onDelete: SetNull)
  lengthMm      Float?
  quantity      Float        @default(1)
  minutes       Float?
  /// Perda de corte/usinagem (bps)
  scrapBps      Int          @default(0)
  /// Custo unitário manual (sobrepõe o do material/processo)
  unitCostCents Int?

  @@index([sheetId, position])
  @@index([subSheetId])
}

/// NF-e de compra importada pelo XML (fonte para custos de materiais)
model PurchaseInvoice {
  id           String                @id @default(cuid())
  accessKey    String                @unique
  number       String
  series       String
  issuedAt     DateTime?
  supplierDoc  String
  supplierName String
  supplierUf   String?
  recipientDoc String?
  totalCents   Int
  xml          String                @db.Text
  items        PurchaseInvoiceItem[]
  createdAt    DateTime              @default(now())

  @@index([supplierDoc])
  @@index([issuedAt])
}

model PurchaseInvoiceItem {
  id                     String          @id @default(cuid())
  invoiceId              String
  invoice                PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position               Int
  code                   String
  description            String
  ncm                    String
  cfop                   String
  unit                   String
  quantity               Float
  totalCents             Int
  ipiCents               Int             @default(0)
  icmsCents              Int             @default(0)
  icmsStCents            Int             @default(0)
  effectiveTotalCents    Int
  effectiveUnitCostCents Int
  /// Material do cadastro que este item abastece
  materialId             String?
  material               Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  /// Conversão quando a nota não vem em kg (ex.: tubo por peça → kg por peça)
  kgPerUnit              Float?
  appliedAt              DateTime?

  @@index([invoiceId, position])
  @@index([materialId])
}
