generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String     @id @default(cuid())
  sku                String     @unique
  slug               String     @unique
  name               String
  shortDesc          String
  description        String     @db.Text
  specs              Json
  priceCents         Int
  originalPriceCents Int?
  stock              Int        @default(0)
  active             Boolean    @default(true)
  featured           Boolean    @default(false)
  images             String[]
  categoryId         String
  category           Category   @relation(fields: [categoryId], references: [id])
  partItems          PartItem[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([active, featured])
  @@index([categoryId])
}

model PartItem {
  id             String             @id @default(cuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  category       String             @default("Geral")
  quantity       Int                @default(1)
  unitPriceCents Int                @default(0)
  notes          String?
  listItems      PurchaseListItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([productId])
  @@index([category])
}

model PurchaseList {
  id        String             @id @default(cuid())
  name      String
  items     PurchaseListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model PurchaseListItem {
  id             String       @id @default(cuid())
  purchaseListId String
  purchaseList   PurchaseList @relation(fields: [purchaseListId], references: [id], onDelete: Cascade)
  partItemId     String
  partItem       PartItem     @relation(fields: [partItemId], references: [id], onDelete: Cascade)

  @@unique([purchaseListId, partItemId])
  @@index([purchaseListId])
}

// ─── Site institucional (editável pelo admin) ──────────────────────────────────

/// Conteúdo editável das seções institucionais (key: "home" | "sobre" | "servicos" | "contato")
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Itens repetentes exibidos na página de Serviços
model ServiceItem {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/// Fotos de obras / projetos / equipamentos exibidas na Galeria
model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/// Mensagens recebidas pelo formulário de contato
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}
