# PostgreSQL local (docker compose up -d). Troque a senha antes de expor o banco.
DATABASE_URL="postgresql://letorneadora:letorneadora@localhost:55433/letorneadora"
DIRECT_URL="postgresql://letorneadora:letorneadora@localhost:55433/letorneadora"

# Upload: local para servidor próprio; blob para Vercel Blob
UPLOAD_STORAGE="local"
BLOB_READ_WRITE_TOKEN=""

# Admin: defina valores fortes apenas no .env.local, nunca no repositório
ADMIN_PASSWORD="troque-esta-senha"
AUTH_COOKIE_SECRET="gere-um-segredo-aleatorio-longo"
# Use false somente no teste local com next start via HTTP. Em produção HTTPS, omita ou use true.
AUTH_COOKIE_SECURE="false"

NEXT_PUBLIC_COMPANY_NAME="LE Torneadora"
NEXT_PUBLIC_COMPANY_PHONE=""
NEXT_PUBLIC_COMPANY_EMAIL=""
NEXT_PUBLIC_COMPANY_ADDRESS="Aparecida de Goiânia - GO"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Asaas (pagamentos) ─────────────────────────────────────────────
# O ambiente é definido pela URL. Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3. A chave precisa ser do MESMO ambiente
# (produção começa com $aact_prod_, sandbox com $aact_hmlg_). No .env escape
# o cifrão: \$aact_... Sem chave coerente a integração fica desligada.
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""          # produção
ASAAS_API_KEY_SANDBOX=""  # usada quando a URL é de sandbox
# Token livre (gere um aleatório) — cadastre o MESMO valor no painel do Asaas
# em Integrações > Webhooks, URL: https://SEU-DOMINIO/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=""

# ─── Fila de jobs (webhooks e tarefas assíncronas) ───────────────────
# Protege /api/cron/jobs (a Vercel Cron envia "Authorization: Bearer $CRON_SECRET").
# Gere com: openssl rand -hex 32
CRON_SECRET=""

# ─── Conta do cliente (Better Auth) ─────────────────────────────────
# Segredo de 32+ bytes: openssl rand -base64 32 (diferente por ambiente)
BETTER_AUTH_SECRET=""
# URL pública do site (padrão: NEXT_PUBLIC_SITE_URL)
BETTER_AUTH_URL=""

# ─── E-mail (Resend) ────────────────────────────────────────────────
# Sem chave, em desenvolvimento os e-mails aparecem no console do servidor.
# O domínio do remetente precisa estar verificado no Resend (DNS SPF/DKIM).
RESEND_API_KEY=""
EMAIL_FROM="L&E Torneadora <nao-responda@letorneadora.com.br>"
# Recebe avisos de novas solicitações de orçamento feitas pelo site
ADMIN_NOTIFY_EMAIL=""
